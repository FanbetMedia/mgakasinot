---
import { brands } from "../data/site";
---
<section class="brand-list" aria-label="MGA kasinot">
{brands.map((brand, i) => (
  <article class:list={["casino-card", i === 0 && "casino-card--featured"]}>
    <div class="casino-rank" aria-label={`Sija ${i+1}`}>{i+1}</div>

    <div class="casino-logo">
      {brand.logo
        ? <img src={brand.logo.replace("https://mgakasinot.com","")} alt={brand.name} width="125" height="58" loading="lazy" decoding="async" />
        : <strong>{brand.name}</strong>}
    </div>

    <div class="casino-main">
      <div class="casino-title-row">
        <h3>{brand.name}</h3>
        {i === 0 && <span class="featured-badge">Listan kärki</span>}
      </div>
      <span class="bonus-label">{brand.bonusType === "deposit" ? "Talletusbonus" : "Bonus"}</span>
      <strong class="bonus">{brand.description}</strong>
    </div>

    <div class="casino-score" aria-label={`Arvosana ${brand.rating} viidestä`}>
      <span class="score-number">{brand.rating}</span>
      <span class="score-max">/ 5</span>
    </div>

    <div class="casino-cta">
      {brand.affiliate
        ? <a class="btn btn-primary" href={brand.affiliate} rel="nofollow sponsored noopener noreferrer" target="_blank">Siirry kasinolle</a>
        : <span class="btn btn-disabled">Ei linkkiä</span>}
    </div>
  </article>
))}
</section>

<style>
.brand-list{gap:12px}
.casino-card{border-color:#dfe6ed;background:#fff;color:#132236;box-shadow:0 15px 36px rgba(0,0,0,.14)}
.casino-card:hover{border-color:#f2aa68;box-shadow:0 18px 42px rgba(0,0,0,.18)}
.casino-card--featured{border-color:#f1ad70;background:linear-gradient(90deg,#fff8f1 0%,#fff 34%)}
.casino-card .casino-main h3{color:#132236}
.casino-card .bonus{color:#34495f}
.casino-card .bonus-label{color:#738395}
.casino-card .score-number{color:#132236}
.casino-card .score-max{color:#718196}
.casino-card .featured-badge{color:#b85a05;background:#fff0e2;border-color:#ffd2ad}
.casino-card .casino-rank{color:#c65f00;background:#fff3e8;border-color:#ffd1a9}
@media(max-width:760px){.casino-card{padding:16px}}
</style>
