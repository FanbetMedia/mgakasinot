---
import { brands } from "../../data/site";
interface Props { heading?: string; limit?: number; minRating?: number }
const { heading = "Poimintoja vertailusta", limit = 5, minRating = 0 } = Astro.props;
const picks = [...brands].filter((b)=>Number(b.rating)>=minRating).sort((a,b)=>Number(b.rating)-Number(a.rating)).slice(0,limit);
---
<section class="mini-list">
  <div class="mini-list__head"><span>KASINOPOIMINNAT</span><h3>{heading}</h3></div>
  <div class="mini-list__rows">
    {picks.map((brand, i)=><div class="mini-list__row"><span class="mini-list__rank">{String(i+1).padStart(2,"0")}</span><div class="mini-list__brand"><strong>{brand.name}</strong><small>{brand.description}</small></div><span class="mini-list__score">{brand.rating}/5</span>{brand.affiliate ? <a href={brand.affiliate} target="_blank" rel="nofollow sponsored noopener">Avaa ↗</a> : <span></span>}</div>)}
  </div>
  <p class="mini-list__note">Poiminnat perustuvat sivuston nykyiseen vertailudataan. Lisenssi kannattaa tarkistaa erikseen ennen pelaamista.</p>
</section>
<style>
.mini-list{width:100%;max-width:100%;margin:42px 0 52px;padding:28px 30px 22px;border:1px solid #dfe6ed;border-radius:18px;background:#fff;color:#132236;box-shadow:0 18px 46px rgba(0,0,0,.16);overflow:hidden}
.mini-list__head{display:flex;justify-content:space-between;align-items:flex-end;gap:28px;margin-bottom:12px;padding-bottom:18px;border-bottom:1px solid #e7edf2}
.mini-list__head span{color:#d96800;font-size:11px;font-weight:900;letter-spacing:.13em}
.mini-list__head h3{margin:0;color:#132236;font-size:24px;line-height:1.2;text-align:right}
.mini-list__rows{width:100%}
.mini-list__row{display:grid;grid-template-columns:48px minmax(0,1fr) 70px 72px;gap:14px;align-items:center;padding:16px 0;border-top:1px solid #edf1f5;min-width:0}
.mini-list__row:first-child{border-top:0}
.mini-list__rank{color:#e8730c;font-weight:950;font-size:12px}
.mini-list__brand{min-width:0}
.mini-list__brand strong{display:block;color:#132236}
.mini-list__brand small{display:block;color:#66788a;margin-top:3px;line-height:1.45;overflow-wrap:anywhere}
.mini-list__score{color:#24384d;font-weight:900}
.mini-list__row a{color:#d96800;text-decoration:none;font-weight:900;text-align:right;white-space:nowrap}
.mini-list__row a:hover{text-decoration:underline;text-underline-offset:3px}
.mini-list__note{margin:16px 0 0;padding-top:14px;border-top:1px solid #edf1f5;color:#728294;font-size:12px}
@media(max-width:620px){.mini-list{padding:22px 18px 18px;border-radius:14px}.mini-list__row{grid-template-columns:34px minmax(0,1fr) 52px}.mini-list__row>a{grid-column:2/4;text-align:left}.mini-list__head{display:block}.mini-list__head h3{margin-top:6px;text-align:left;font-size:21px}}
</style>