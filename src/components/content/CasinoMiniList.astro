---
import { brands } from "../../data/site";
interface Props { heading?: string; limit?: number; minRating?: number }
const { heading = "Poimintoja vertailusta", limit = 5, minRating = 0 } = Astro.props;
const picks = [...brands].filter((b)=>Number(b.rating)>=minRating).sort((a,b)=>Number(b.rating)-Number(a.rating)).slice(0,limit);
---
<section class="mini-list">
  <div class="mini-list__head"><span>KASINOPOIMINNAT</span><h3>{heading}</h3></div>
  <div class="mini-list__rows">
    {picks.map((brand, i)=><div class="mini-list__row"><span class="mini-list__rank">{String(i+1).padStart(2,"0")}</span><div class="mini-list__brand"><strong>{brand.name}</strong><small>{brand.description}</small></div><span class="mini-list__score">{brand.rating}/5</span>{brand.affiliate ? <a href={brand.affiliate} target="_blank" rel="nofollow sponsored noopener">Avaa ↗</a> : <span></span>}</div>)}
  </div>
  <p class="mini-list__note">Poiminnat perustuvat sivuston nykyiseen vertailudataan. Lisenssi kannattaa tarkistaa erikseen ennen pelaamista.</p>
</section>
<style>
.mini-list{margin:42px 0 52px;padding:26px 0;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14)}.mini-list__head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:12px}.mini-list__head span{color:#ffab5d;font-size:11px;font-weight:900;letter-spacing:.13em}.mini-list__head h3{margin:0;color:#fff;font-size:24px}.mini-list__row{display:grid;grid-template-columns:48px minmax(0,1fr) 70px 64px;gap:14px;align-items:center;padding:14px 0;border-top:1px solid rgba(255,255,255,.08)}.mini-list__rank{color:#ff9f47;font-weight:950;font-size:12px}.mini-list__brand strong{display:block;color:#fff}.mini-list__brand small{display:block;color:#8fa4b9;margin-top:3px}.mini-list__score{color:#dbe5ee;font-weight:850}.mini-list__row a{color:#ffab5d;text-decoration:none;font-weight:850;text-align:right}.mini-list__note{margin:14px 0 0;color:#70869a;font-size:12px}
@media(max-width:620px){.mini-list__row{grid-template-columns:38px 1fr 56px}.mini-list__row>a{grid-column:2/4;text-align:left}.mini-list__head{display:block}.mini-list__head h3{margin-top:5px}}
</style>