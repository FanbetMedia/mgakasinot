---
type Step = { title: string; text: string };
interface Props { steps: Step[]; eyebrow?: string; title?: string }
const { steps, eyebrow = "Näin se toimii", title } = Astro.props;
---
<section class="stepguide">
  <div class="stepguide__head">
    <span>{eyebrow}</span>
    {title && <h3>{title}</h3>}
  </div>
  <ol class="stepguide__list">
    {steps.map((step, i)=><li><span class="stepguide__num">{String(i+1).padStart(2,"0")}</span><div><strong>{step.title}</strong><p>{step.text}</p></div></li>)}
  </ol>
</section>
<style>
.stepguide{margin:42px 0 52px;padding:30px 0;border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14)}
.stepguide__head{display:flex;align-items:baseline;justify-content:space-between;gap:24px;margin-bottom:18px}.stepguide__head>span{color:#ffab5d;font-size:11px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.stepguide__head h3{margin:0;font-size:24px;color:#fff}
.stepguide__list{list-style:none;margin:0;padding:0}.stepguide__list li{display:grid;grid-template-columns:58px 1fr;gap:18px;padding:18px 0;border-top:1px solid rgba(255,255,255,.08)}.stepguide__list li:first-child{border-top:0}.stepguide__num{font-weight:950;color:#ff9a40;font-size:14px;letter-spacing:.08em}.stepguide__list strong{display:block;color:#fff;font-size:17px}.stepguide__list p{margin:4px 0 0;color:#9fb0c1;font-size:14px}
</style>