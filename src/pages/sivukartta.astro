---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pages } from "../data/site";

const links = pages
  .filter((page) => page?.slug && page?.title)
  .map((page) => ({ href: `/${page.slug}/`, title: page.title }))
  .sort((a, b) => a.title.localeCompare(b.title, "fi"));
---
<BaseLayout title="Sivukartta | MGA Kasinot" description="MGA Kasinot -sivuston sivukartta ja linkit kaikkiin oppaisiin, kasinovertailuihin ja artikkeleihin." canonical="/sivukartta/">
  <section class="page-hero page-hero--compact">
    <div class="shell">
      <span class="eyebrow">MGA Kasinot · navigointi</span>
      <h1>Sivukartta</h1>
      <p>Kaikki sivuston tärkeimmät oppaat, vertailut ja artikkelit yhdessä näkymässä.</p>
    </div>
  </section>
  <section class="section">
    <div class="shell sitemap-page">
      <div class="sitemap-grid">
        <a class="sitemap-card sitemap-card--featured" href="/"><span>Etusivu</span><small>Takaisin MGA Kasinot -etusivulle</small></a>
        <a class="sitemap-card sitemap-card--featured" href="/artikkelit/"><span>Artikkelit</span><small>Uutiset, oppaat ja ajankohtaiset sisällöt</small></a>
        {links.map((link) => <a class="sitemap-card" href={link.href}><span>{link.title}</span><small>{link.href}</small></a>)}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
.sitemap-page{padding-bottom:38px}.sitemap-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.sitemap-card{min-width:0;padding:18px 19px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.035);text-decoration:none;transition:transform .18s ease,border-color .18s ease,background .18s ease}.sitemap-card:hover{transform:translateY(-2px);border-color:rgba(255,138,31,.35);background:rgba(255,255,255,.055)}.sitemap-card span{display:block;color:#fff;font-weight:850;line-height:1.3;overflow-wrap:anywhere}.sitemap-card small{display:block;margin-top:6px;color:var(--muted);font-size:12px;overflow-wrap:anywhere}.sitemap-card--featured{background:linear-gradient(145deg,rgba(255,138,31,.1),rgba(255,255,255,.035));border-color:rgba(255,138,31,.22)}@media(max-width:820px){.sitemap-grid{grid-template-columns:1fr 1fr}}@media(max-width:540px){.sitemap-grid{grid-template-columns:1fr}}
</style>