---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandTable from "../components/BrandTable.astro";
import StructuredContent from "../components/StructuredContent.astro";
import { pages } from "../data/site";
import { buildInternalLinks } from "../lib/internalLinks";
import { optimizeContentImages } from "../lib/contentImages";

export function getStaticPaths(){
  return pages
    .filter((p)=>p.slug !== "mga-kasinot")
    .map((page)=>({params:{slug:page.slug},props:{page}}));
}

const { page } = Astro.props;
const marker = '<div data-brand-table></div>';
const linkedHtml = optimizeContentImages(buildInternalLinks(page.html, `/${page.slug}/`));
const hasTable = linkedHtml.includes(marker);
const [beforeTable, afterTable=''] = hasTable ? linkedHtml.split(marker) : ['', linkedHtml];
const isArticle = page.type === "post";
---
<BaseLayout
  title={page.seoTitle}
  description={page.description}
  canonical={`/${page.slug}/`}
  pageType={isArticle ? "Article" : "WebPage"}
>
  <section class:list={["page-hero", "page-hero--editorial", isArticle && "page-hero--article"]}>
    <div class="shell page-hero__grid">
      <div class="page-hero__copy">
        <span class="eyebrow">{isArticle ? "ARTIKKELI" : "MGA KASINOT • OPAS"}</span>
        <h1>{page.title}</h1>
        {page.description && <p>{page.description}</p>}
        <div class="page-hero__meta" aria-label="Sisällön tiedot">
          <span>{isArticle ? "Ajankohtainen sisältö" : "Opas ja vertailu"}</span>
          <span>Suomeksi</span>
          <span>18+</span>
        </div>
      </div>

      <aside class="page-hero__mark" aria-hidden="true">
        <span class="page-hero__mark-kicker">MGAKASINOT.COM</span>
        <strong>MGA</strong>
        <div class="page-hero__mark-line"></div>
        <p>{isArticle ? "Taustaa, faktoja ja käytännön näkökulmaa ilman turhaa täytettä." : "Selkeämpi tapa vertailla, tarkistaa ja ymmärtää kasinosisältöä."}</p>
        <small>{isArticle ? "JOURNAL" : "GUIDE"}</small>
      </aside>
    </div>
  </section>

  <section class="section shell page-editorial-shell">
    <article class:list={["content", "page-editorial", isArticle && "page-editorial--article"]}>
      {hasTable && beforeTable && <div class="content-intro"><Fragment set:html={beforeTable} /></div>}
      {hasTable && <div class="page-editorial__comparison"><BrandTable /></div>}
      <StructuredContent html={afterTable} slug={page.slug} type={page.type} />
    </article>

    {isArticle && (
      <div class="page-editorial__backlink">
        <a class="text-link" href="/artikkelit/">← Takaisin kaikkiin artikkeleihin</a>
      </div>
    )}
  </section>
</BaseLayout>

<style>
.content-intro{margin-bottom:26px}
</style>
