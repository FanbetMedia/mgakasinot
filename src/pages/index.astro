---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandTable from "../components/BrandTable.astro";
import { pages, brands } from "../data/site";

const page = pages.find((p)=>p.slug === "mga-kasinot")!;
const marker = '<div data-brand-table></div>';
const [before, after=''] = page.html.split(marker);
const articles = pages.filter((p)=>p.type === "post").slice(0,3);
---
<BaseLayout title={page.seoTitle} description={page.description} canonical="/">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">MGA-LISENSSIN ALLA TOIMIVAT KASINOT</span>
        <h1>MGA kasinot suomalaisille pelaajille</h1>
        <p class="hero-lead">Vertaa MGA-lisenssin alla toimivia kasinoita, bonuksia ja ajankohtaisia sisältöjä yhdellä sivustolla.</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-large" href="#kasinovertailu">Vertaa kasinoita</a>
          <a class="btn btn-secondary btn-large" href="/kasinobonukset/">Katso kasinobonukset</a>
        </div>
        <div class="hero-stats">
          <div><strong>{brands.length}</strong><span>kasinoa vertailussa</span></div>
          <div><strong>{pages.filter((p)=>p.type === "post").length}</strong><span>artikkelia</span></div>
          <div><strong>18+</strong><span>pelaa vastuullisesti</span></div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-orb hero-orb--one"></div>
        <div class="hero-orb hero-orb--two"></div>
        <div class="hero-card hero-card--main">
          <span>MGA Kasinot</span>
          <strong>Selkeä vertailu.<br/>Nopea valinta.</strong>
          <small>Bonukset, lisenssit ja ajankohtaiset artikkelit yhdessä paikassa.</small>
        </div>
        <div class="hero-card hero-card--mini">MGA</div>
        <div class="hero-card hero-card--mini hero-card--mini-2">18+</div>
      </div>
    </div>
  </section>

  <section class="shell feature-grid" aria-label="Sivuston pääosiot">
    <a class="feature-card" href="/nettikasinot/">
      <span class="feature-icon">01</span>
      <h2>Nettikasinot</h2>
      <p>Vertaa kasinoita ja niiden tarjouksia samassa näkymässä.</p>
      <span class="text-link">Avaa vertailu →</span>
    </a>
    <a class="feature-card" href="/kasinobonukset/">
      <span class="feature-icon">02</span>
      <h2>Kasinobonukset</h2>
      <p>Tarkista ajankohtaiset bonusvaihtoehdot ja ehdot.</p>
      <span class="text-link">Katso bonukset →</span>
    </a>
    <a class="feature-card" href="/artikkelit/">
      <span class="feature-icon">03</span>
      <h2>Artikkelit</h2>
      <p>Lue oppaita lisensseistä, maksuista ja rahapelialasta.</p>
      <span class="text-link">Lue artikkelit →</span>
    </a>
  </section>

  <section class="section shell" id="kasinovertailu">
    <div class="section-heading">
      <div>
        <span class="eyebrow">KASINOVERTAILU</span>
        <h2>MGA kasinot vertailussa</h2>
      </div>
      <p>Kasinoiden tiedot perustuvat sivustolle tuotuun Brand Table -dataan.</p>
    </div>
    <BrandTable />
  </section>

  <section class="section shell article-showcase">
    <div class="section-heading">
      <div>
        <span class="eyebrow">AJANKOHTAISTA</span>
        <h2>Uusimmat artikkelit</h2>
      </div>
      <a class="text-link" href="/artikkelit/">Kaikki artikkelit →</a>
    </div>
    <div class="article-card-grid">
      {articles.map((article) => (
        <a class="article-card" href={`/${article.slug}/`}>
          <span class="article-kicker">Artikkeli</span>
          <h3>{article.title}</h3>
          <p>{article.description || "Lue artikkeli ja tutustu aiheeseen tarkemmin."}</p>
          <span class="text-link">Lue lisää →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section shell">
    <article class="content content-home">
      <Fragment set:html={before} />
      <Fragment set:html={after} />
    </article>
  </section>
</BaseLayout>
