DirectoryIndex index.html

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Canonical host: HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.mgakasinot\.com$ [NC]
RewriteRule ^ https://mgakasinot.com%{REQUEST_URI} [R=301,L]

# Preserve legacy homepage page slug
RewriteRule ^mga-kasinot/?$ https://mgakasinot.com/ [R=301,L]
