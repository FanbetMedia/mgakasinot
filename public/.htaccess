DirectoryIndex index.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # HTML should always be revalidated before a cached copy is reused.
  # This matches the cache model already working on vedonlyontibonukset.org.
  <FilesMatch "\.html$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # The MGA registry is regenerated automatically and should never go stale.
  <Files "mga-sites.json">
    Header always set Cache-Control "no-cache, no-store, max-age=0, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </Files>

  # Content images can remain cached for 30 days.
  <FilesMatch "\.(avif|webp|png|jpe?g|gif|svg|ico)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Astro fingerprints compiled assets, so immutable one-year caching is safe.
  SetEnvIf Request_URI "^/_astro/" ASTRO_IMMUTABLE=1
  Header always set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_IMMUTABLE
</IfModule>

RewriteEngine On

# Canonical host: HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.mgakasinot\.com$ [NC]
RewriteRule ^ https://mgakasinot.com%{REQUEST_URI} [R=301,L]

# Preserve legacy homepage page slug
RewriteRule ^mga-kasinot/?$ https://mgakasinot.com/ [R=301,L]
