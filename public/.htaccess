DirectoryIndex index.html

<IfModule mod_headers.c>
  # HTML changes must be visible immediately after each GitHub deploy.
  # SiteGround documents Cache-Control: private for disabling server-side cache
  # on non-WordPress sites. X-Accel-Expires: 0 also prevents CDN edge caching.
  <FilesMatch "\.html$">
    Header always set Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"
    Header always set X-Accel-Expires "0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # The MGA registry snapshot is regenerated on deploy and must not go stale.
  <Files "mga-sites.json">
    Header always set Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate"
    Header always set X-Accel-Expires "0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </Files>

  # Content images can remain cached for 30 days.
  <FilesMatch "\.(avif|webp|png|jpe?g|gif|svg|ico)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Astro fingerprints compiled assets, so immutable one-year caching is safe.
  SetEnvIf Request_URI "^/_astro/" ASTRO_IMMUTABLE=1
  Header always set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_IMMUTABLE
</IfModule>

RewriteEngine On

# Canonical host: HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.mgakasinot\.com$ [NC]
RewriteRule ^ https://mgakasinot.com%{REQUEST_URI} [R=301,L]

# Preserve legacy homepage page slug
RewriteRule ^mga-kasinot/?$ https://mgakasinot.com/ [R=301,L]
