DirectoryIndex index.html

<IfModule mod_headers.c>
  # HTML must always be revalidated so a GitHub deploy becomes visible immediately.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # Content images can stay cached for 30 days. They are much heavier than HTML
  # and normally keep stable filenames.
  <FilesMatch "\.(avif|webp|png|jpe?g|gif|svg|ico)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Astro generates fingerprinted assets under /_astro/. Their filenames change
  # when the file content changes, so a one-year immutable cache is safe.
  SetEnvIf Request_URI "^/_astro/" ASTRO_IMMUTABLE=1
  Header always set Cache-Control "public, max-age=31536000, immutable" env=ASTRO_IMMUTABLE
</IfModule>

RewriteEngine On

# Canonical host: HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.mgakasinot\.com$ [NC]
RewriteRule ^ https://mgakasinot.com%{REQUEST_URI} [R=301,L]

# Preserve legacy homepage page slug
RewriteRule ^mga-kasinot/?$ https://mgakasinot.com/ [R=301,L]
